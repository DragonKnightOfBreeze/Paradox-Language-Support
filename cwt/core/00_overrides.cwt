# Override Config (Core)
#
# Configures the override strategy per entry-relative directory. The strategy drives the order in
# which targets take effect and the sorting of non-streaming query results, and is used by the
# override-related inspections. Game-specific configs (`config/overrides.cwt`) may add or override
# entries; entries with the same key follow the more specific config group.
#
# Format:
#   overrides = {
#       "path/to/dir" = strategy
#   }
# - Key: directory path relative to the entry directory (usually the game or mod directory, or the
#   `game` subdirectory of the game directory). Must be a concrete path.
# - Value: override strategy, case-insensitive; defaults to `lios` when unmatched.
#
# Strategies:
# - fios:    First In, Only Served. The first loaded wins; later ones are ignored.
# - lios:    Last In, Only Served. The last loaded overrides earlier ones. (default)
# - dupl:    Duplicates. The whole file must be replaced by a file at the same path.
# - ordered: Ordered. Later items are added or merged in order without overriding.
#
# Confidence labels (based on multiple sources):
# - [high]:   Consistent across independent sources, or clearly evidenced.
# - [medium]: Single trusted source, or sources mostly agree with minor differences.
# - [low]:    Inferred or conventional, not yet verified.
#
# Sources:
# - Stellaris Wiki "file overwrite list" (translated by pdxdoc / Stellaris Mod Group):
#   https://main--pdxdoc-next.netlify.app/guides/other/overwrite/
# - IronyModManager (IMM): https://github.com/bcssov/IronyModManager
# - Official wikis (e.g. https://stellaris.paradoxwikis.com/Stellaris_Wiki)
#
# See: docs/en/ref-config-format.md#config-override
# Domain note: the override-strategy note under documents/ai-notes/domain/
# Version: 3.0.4-dev
# Date: 2026-10-02

overrides = {
    # [medium] Event chains are read once; general convention verified mainly for Stellaris.
    "common/event_chains" = fios

    # [high] On actions are automatically merged in load order, without overriding.
    "common/on_actions" = ordered

    # [high] Global scripted variables are read once; later duplicates are ignored.
    "common/scripted_variables" = fios

    # [medium] Events are read once; general convention verified mainly for Stellaris.
    "events" = fios
}
