<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <fileType language="CWT" name="Cwt" fieldName="INSTANCE" implementationClass="icu.windea.pls.cwt.CwtFileType" extensions="cwt"/>
    <lang.parserDefinition language="CWT" implementationClass="icu.windea.pls.cwt.CwtParserDefinition"/>

    <lang.foldingBuilder language="CWT" implementationClass="icu.windea.pls.cwt.folding.CwtFoldingBuilder"/>

    <langCodeStyleSettingsProvider implementation="icu.windea.pls.cwt.formatter.CwtCodeStyleSettingsProvider"/>
    <lang.formatter language="CWT" implementationClass="icu.windea.pls.cwt.formatter.CwtFormattingModelBuilder"/>

    <lang.braceMatcher language="CWT" implementationClass="icu.windea.pls.cwt.codeInsight.highlighting.CwtBraceMatcher"/>
    <lang.surroundDescriptor language="CWT" implementationClass="icu.windea.pls.cwt.codeInsight.surroundWith.CwtSurroundDescriptor"/>
    <lang.unwrapDescriptor language="CWT" implementationClass="icu.windea.pls.cwt.codeInsight.unwrap.CwtUnwrapDescriptor"/>
    <annotator language="CWT" implementationClass="icu.windea.pls.cwt.codeInsight.CwtSyntaxAnnotator"/>
    <lang.implementationTextSelectioner language="CWT" implementationClass="icu.windea.pls.cwt.codeInsight.CwtImplementationTextSelectioner"/>

    <liveTemplateContext contextId="CWT"
                         implementation="icu.windea.pls.cwt.codeInsight.template.CwtTemplateContextType$Base"/>
    <liveTemplateContext contextId="CWT_MEMBERS" baseContextId="CWT"
                         implementation="icu.windea.pls.cwt.codeInsight.template.CwtTemplateContextType$Members"/>

    <lang.commenter language="CWT" implementationClass="icu.windea.pls.cwt.editor.CwtCommenter"/>
    <enterHandlerDelegate implementation="icu.windea.pls.cwt.editor.CwtEnterHandler"/>
    <statementUpDownMover implementation="icu.windea.pls.cwt.editor.CwtMover"/>
    <lang.quoteHandler language="CWT" implementationClass="icu.windea.pls.cwt.editor.CwtQuoteHandler"/>
    <lang.smartEnterProcessor language="CWT" implementationClass="icu.windea.pls.cwt.editor.CwtSmartEnterProcessor"/>
    <extendWordSelectionHandler implementation="icu.windea.pls.cwt.editor.CwtWordSelectionHandler"/>

    <colorSettingsPage implementation="icu.windea.pls.cwt.highlighting.CwtColorSettingsPage"/>
    <lang.syntaxHighlighterFactory language="CWT" implementationClass="icu.windea.pls.cwt.highlighting.CwtSyntaxHighlighterFactory"/>

    <lang.psiStructureViewFactory language="CWT" implementationClass="icu.windea.pls.cwt.structureView.CwtStructureViewFactory"/>
    <navbar implementation="icu.windea.pls.cwt.navigationToolbar.CwtNavBar"/>
    <breadcrumbsInfoProvider implementation="icu.windea.pls.cwt.breadcrumbs.CwtBreadCrumbsProvider"/>

    <spellchecker.support language="CWT" implementationClass="icu.windea.pls.cwt.spellchecker.CwtSpellcheckerStrategy"/>

    <elementDescriptionProvider implementation="icu.windea.pls.cwt.psi.CwtElementDescriptionProvider"/>

    <lang.elementManipulator forClass="icu.windea.pls.cwt.psi.CwtOptionKey"
                             implementationClass="icu.windea.pls.cwt.psi.CwtElementManipulators$OptionKeyManipulator"/>
    <lang.elementManipulator forClass="icu.windea.pls.cwt.psi.CwtPropertyKey"
                             implementationClass="icu.windea.pls.cwt.psi.CwtElementManipulators$PropertyKeyManipulator"/>
    <lang.elementManipulator forClass="icu.windea.pls.cwt.psi.CwtString"
                             implementationClass="icu.windea.pls.cwt.psi.CwtElementManipulators$StringManipulator"/>
    <lang.elementManipulator forClass="icu.windea.pls.cwt.psi.CwtValue"
                             implementationClass="icu.windea.pls.cwt.psi.CwtElementManipulators$ValueManipulator"/>
  </extensions>
</idea-plugin>
