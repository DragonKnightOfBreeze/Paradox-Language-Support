<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <fileType language="PARADOX_SCRIPT" name="Paradox Script" fieldName="INSTANCE" implementationClass="icu.windea.pls.script.ParadoxScriptFileType"
              fileNames="descriptor.mod"/>
    <lang.parserDefinition language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.ParadoxScriptParserDefinition"/>

    <lang.foldingBuilder language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.folding.ParadoxScriptFoldingBuilder"/>

    <langCodeStyleSettingsProvider implementation="icu.windea.pls.script.formatter.ParadoxScriptCodeStyleSettingsProvider"/>
    <lang.formatter language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.formatter.ParadoxScriptFormattingModelBuilder"/>

    <annotator language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.codeInsight.ParadoxScriptSyntaxAnnotator"/>

    <lang.braceMatcher language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.codeInsight.highlighting.ParadoxScriptBraceMatcher"/>
    <lang.surroundDescriptor language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.codeInsight.surroundWith.ParadoxScriptSurroundDescriptor"/>
    <lang.unwrapDescriptor language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.codeInsight.unwrap.ParadoxScriptUnwrapDescriptor"/>
    <colorProvider implementation="icu.windea.pls.lang.codeInsight.color.ParadoxElementColorProvider"/>
    <lang.implementationTextSelectioner language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.codeInsight.ParadoxScriptImplementationTextSelectioner"/>

    <liveTemplateContext contextId="PARADOX_SCRIPT"
                         implementation="icu.windea.pls.script.codeInsight.template.ParadoxScriptTemplateContextType$Base"/>
    <liveTemplateContext contextId="PARADOX_SCRIPT_MEMBERS" baseContextId="PARADOX_SCRIPT"
                         implementation="icu.windea.pls.script.codeInsight.template.ParadoxScriptTemplateContextType$Members"/>
    <liveTemplateContext contextId="PARADOX_SCRIPT_INLINE_MATH_EXPRESSIONS" baseContextId="PARADOX_SCRIPT"
                         implementation="icu.windea.pls.script.codeInsight.template.ParadoxScriptTemplateContextType$InlineMathExpressions"/>

    <lang.commenter language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.editor.ParadoxScriptCommenter"/>
    <statementUpDownMover implementation="icu.windea.pls.script.editor.ParadoxScriptMover"/>
    <lang.quoteHandler language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.editor.ParadoxScriptQuoteHandler"/>
    <lang.smartEnterProcessor language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.editor.ParadoxScriptSmartEnterProcessor"/>
    <extendWordSelectionHandler implementation="icu.windea.pls.script.editor.ParadoxScriptWordSelectionHandler"/>

    <colorSettingsPage implementation="icu.windea.pls.script.highlighting.ParadoxScriptColorSettingsPage"/>
    <lang.syntaxHighlighterFactory language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.highlighting.ParadoxScriptSyntaxHighlighterFactory"/>

    <lang.psiStructureViewFactory language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.structureView.ParadoxScriptStructureViewFactory"/>
    <navbar implementation="icu.windea.pls.script.navigationToolbar.ParadoxScriptNavBar"/>
    <breadcrumbsInfoProvider implementation="icu.windea.pls.script.breadcrumbs.ParadoxScriptBreadCrumbsProvider"/>

    <spellchecker.support language="PARADOX_SCRIPT" implementationClass="icu.windea.pls.script.spellchecker.ParadoxScriptSpellcheckerStrategy"/>

    <elementDescriptionProvider implementation="icu.windea.pls.script.psi.ParadoxScriptElementDescriptionProvider"/>

    <lang.elementManipulator forClass="icu.windea.pls.script.psi.ParadoxScriptPropertyKey"
                             implementationClass="icu.windea.pls.script.psi.ParadoxScriptElementManipulators$PropertyKeyManipulator"/>
    <lang.elementManipulator forClass="icu.windea.pls.script.psi.ParadoxScriptValue"
                             implementationClass="icu.windea.pls.script.psi.ParadoxScriptElementManipulators$ValueManipulator"/>
    <lang.elementManipulator forClass="icu.windea.pls.script.psi.ParadoxScriptString"
                             implementationClass="icu.windea.pls.script.psi.ParadoxScriptElementManipulators$StringManipulator"/>

    <additionalTextAttributes scheme="Default" file="colorSchemes/ParadoxScriptDefault.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/ParadoxScriptDarcula.xml"/>
    <additionalTextAttributes scheme="High contrast" file="colorSchemes/ParadoxScriptHighContrast.xml"/>
    <additionalTextAttributes scheme="Light" file="colorSchemes/ParadoxScriptLight.xml"/>
    <additionalTextAttributes scheme="Dark" file="colorSchemes/ParadoxScriptDark.xml"/>
    <additionalTextAttributes scheme="Islands Dark" file="colorSchemes/ParadoxScriptIslandsDark.xml"/> <!-- should use `Islands Dark` here -->
  </extensions>
</idea-plugin>
