<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="icu.windea.pls.base.ChronicleCapacities$Listener"/>
    <postStartupActivity implementation="icu.windea.pls.base.ChronicleLifecycleListener"/>

    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleDataPathService" serviceImplementation="icu.windea.pls.base.io.ChronicleDataPathServiceImpl"/>
    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleGitService" serviceImplementation="icu.windea.pls.base.io.ChronicleGitServiceImpl"/>
    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleSqliteService" serviceImplementation="icu.windea.pls.base.io.ChronicleSqliteServiceImpl"/>

    <notificationGroup id="chronicle" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBundle" key="notificationGroup"/>
    <notificationGroup id="chronicle.settings" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBundle" key="notificationGroup.settings"/>
    <notificationGroup id="chronicle.diff" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBundle" key="notificationGroup.diff"/>
    <notificationGroup id="chronicle.manipulation" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBundle" key="notificationGroup.manipulation"/>

    <webHelpProvider implementation="icu.windea.pls.base.help.ChronicleHelpProvider"/>
    <iconMapper mappingFile="ChronicleIconMappings.json"/>
  </extensions>

  <applicationListeners>
    <listener class="icu.windea.pls.base.ChronicleLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="icu.windea.pls.base.settings.ChronicleSettingsMigrator" topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>
</idea-plugin>
