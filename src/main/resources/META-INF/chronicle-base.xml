<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="icu.windea.pls.base.listeners.ChronicleLifecycleListener"/>

    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleDataPathService" serviceImplementation="icu.windea.pls.base.io.ChronicleDataPathServiceImpl"/>
    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleGitService" serviceImplementation="icu.windea.pls.base.io.ChronicleGitServiceImpl"/>
    <applicationService serviceInterface="icu.windea.pls.base.io.ChronicleSqliteService" serviceImplementation="icu.windea.pls.base.io.ChronicleSqliteServiceImpl"/>

    <applicationConfigurable id="chronicle" groupId="language"
                             bundle="messages.ChronicleBaseBundle" key="settings"
                             instance="icu.windea.pls.base.settings.ChronicleSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.config" parentId="chronicle" groupWeight="90"
                             bundle="messages.ChronicleBaseBundle" key="settings.config"
                             instance="icu.windea.pls.base.settings.ChronicleConfigSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.images" parentId="chronicle" groupWeight="80"
                             bundle="messages.ChronicleBaseBundle" key="settings.images"
                             instance="icu.windea.pls.base.settings.ChronicleImageSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.extensions" parentId="chronicle" groupWeight="70"
                             bundle="messages.ChronicleBaseBundle" key="settings.extensions"
                             instance="icu.windea.pls.base.settings.ChronicleExtensionSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.presentation" parentId="chronicle" groupWeight="85"
                             bundle="messages.ChronicleBaseBundle" key="settings.presentation"
                             instance="icu.windea.pls.base.settings.ChroniclePresentationSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.integrations" parentId="chronicle" groupWeight="60"
                             bundle="messages.ChronicleBaseBundle" key="settings.integrations"
                             instance="icu.windea.pls.base.settings.ChronicleIntegrationSettingsConfigurable"/>
    <applicationConfigurable id="chronicle.ai" parentId="chronicle" groupWeight="40"
                             bundle="messages.ChronicleBaseBundle" key="settings.ai"
                             instance="icu.windea.pls.base.settings.ChronicleAiSettingsConfigurable"/>

    <notificationGroup id="chronicle" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBaseBundle" key="notificationGroup"/>
    <notificationGroup id="chronicle.settings" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBaseBundle" key="notificationGroup.settings"/>
    <notificationGroup id="chronicle.diff" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBaseBundle" key="notificationGroup.diff"/>
    <notificationGroup id="chronicle.manipulation" displayType="BALLOON" isLogByDefault="true" bundle="messages.ChronicleBaseBundle" key="notificationGroup.manipulation"/>

    <webHelpProvider implementation="icu.windea.pls.base.help.ChronicleHelpProvider"/>
    <iconMapper mappingFile="ChronicleIconMappings.json"/>
  </extensions>

  <applicationListeners>
    <listener class="icu.windea.pls.base.listeners.ChronicleLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="icu.windea.pls.base.listeners.ChronicleSettingsMigrationListener" topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>
</idea-plugin>
