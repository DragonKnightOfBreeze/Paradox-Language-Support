<idea-plugin>
  <extensionPoints>
    <extensionPoint qualifiedName="icu.windea.pls.inject.codeInjectorSupport" interface="icu.windea.pls.inject.CodeInjectorSupport" dynamic="true"/>
    <extensionPoint qualifiedName="icu.windea.pls.inject.codeInjector" interface="icu.windea.pls.inject.CodeInjector" dynamic="true"/>
  </extensionPoints>

  <applicationListeners>
    <listener class="icu.windea.pls.inject.CodeInjectorService$Listener" topic="com.intellij.ide.AppLifecycleListener"/>
  </applicationListeners>

  <extensions defaultExtensionNs="icu.windea.pls.inject">
    <codeInjectorSupport implementation="icu.windea.pls.inject.supports.BaseCodeInjectorSupport"/>
    <codeInjectorSupport implementation="icu.windea.pls.inject.supports.FieldCacheCodeInjectorSupport"/>
    <codeInjectorSupport implementation="icu.windea.pls.inject.supports.OptimizedFieldCodeInjectorSupport"/>
    <codeInjectorSupport implementation="icu.windea.pls.inject.supports.InlinedDelegateFieldCodeInjectorSupport"/>
  </extensions>

  <extensions defaultExtensionNs="icu.windea.pls.inject">
    <!-- Core code injectors -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.LowLevelSearchUtilCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.RefManagerImplCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.LineCommentCopyPastePreProcessorCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.CommentByLineCommentHandlerCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.PathReferenceManagerImplCodeInjector"/>

    <!-- Code injectors to provide additional features -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.FileRenderCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.InjectionRegistrarImplCodeInjector"/>

    <!-- Code injectors to optimize image readers (delegate to image tools) -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.DDSImageReaderCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.TGAImageReaderCodeInjector"/>

    <!-- Code injectors to fix bugs -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.fix.SymbolNavigationServiceImplCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.fix.InjectLanguageActionCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.fix.WithAttributesPresentationCodeInjector"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.fix.IdentifierHighlightingComputerCodeInjector"/>

    <!-- Code injectors to optimize memory -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.OptimizedFieldCodeInjectors$BasePresentation"/>

    <!-- Code injectors to optimize performance -->
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$Property"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$PropertyKey"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$Option"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$OptionKey"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$Boolean"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$Int"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$Float"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.CwtPsiCodeInjectors$String"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$ScriptedVariable"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$ScriptedVariableName"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$Property"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$PropertyKey"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$Boolean"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$Int"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$Float"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$String"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$ConditionalParameter"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$NormalParameter"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxScriptPsiCodeInjectors$InlineMathParameter"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$Locale"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$Property"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$PropertyKey"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$PropertyValue"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$Parameter"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$Icon"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$TextFormat"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxLocalisationPsiCodeInjectors$TextIcon"/>
    <codeInjector implementation="icu.windea.pls.inject.injectors.opt.ParadoxCsvPsiCodeInjectors$Column"/>
  </extensions>

  <extensionPoints>
    <extensionPoint qualifiedName="icu.windea.pls.inject.injectedFileProcessor" interface="icu.windea.pls.inject.processors.InjectedFileProcessor" dynamic="true"/>
  </extensionPoints>
</idea-plugin>
