<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <fileType language="PARADOX_CSV" name="Paradox Csv" fieldName="INSTANCE" implementationClass="icu.windea.pls.csv.ParadoxCsvFileType"/>
    <lang.parserDefinition language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.ParadoxCsvParserDefinition"/>

    <lang.foldingBuilder language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.folding.ParadoxCsvFoldingBuilder"/>

    <langCodeStyleSettingsProvider implementation="icu.windea.pls.csv.formatter.ParadoxCsvCodeStyleSettingsProvider"/>

    <highlightUsagesHandlerFactory implementation="icu.windea.pls.csv.codeInsight.highlighting.ParadoxCsvHighlightUsagesHandlerFactory"/>

    <lang.unwrapDescriptor language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.codeInsight.unwrap.ParadoxCsvUnwrapDescriptor"/>
    <annotator language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.codeInsight.ParadoxCsvSyntaxAnnotator"/>
    <declarationRangeHandler key="icu.windea.pls.csv.psi.ParadoxCsvRow" implementationClass="icu.windea.pls.csv.codeInsight.ParadoxCsvDeclarationRangeHandler"/>

    <lang.commenter language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.editor.ParadoxCsvCommenter"/>
    <extendWordSelectionHandler implementation="icu.windea.pls.csv.editor.ParadoxCsvWordSelectionHandler"/>
    <lang.quoteHandler language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.editor.ParadoxCsvQuoteHandler"/>

    <colorSettingsPage implementation="icu.windea.pls.csv.highlighting.ParadoxCsvColorSettingsPage"/>
    <lang.syntaxHighlighterFactory language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.highlighting.ParadoxCsvSyntaxHighlighterFactory"/>
    <annotator language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.highlighting.ParadoxCsvHighlightingAnnotator"/>

    <lang.psiStructureViewFactory language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.structureView.ParadoxCsvStructureViewFactory"/>
    <navbar implementation="icu.windea.pls.csv.navigationToolbar.ParadoxCsvNavBar"/>
    <breadcrumbsInfoProvider implementation="icu.windea.pls.csv.breadcrumbs.ParadoxCsvBreadCrumbsProvider"/>

    <spellchecker.support language="PARADOX_CSV" implementationClass="icu.windea.pls.csv.spellchecker.ParadoxCsvSpellcheckerStrategy"/>

    <lang.elementManipulator forClass="icu.windea.pls.csv.psi.ParadoxCsvColumn"
                             implementationClass="icu.windea.pls.csv.psi.ParadoxCsvElementManipulators$ColumnManipulator"/>
  </extensions>
</idea-plugin>
