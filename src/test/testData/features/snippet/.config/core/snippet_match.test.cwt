# 用于测试片段匹配（`DefinitionSnippet` / `LocalisationSnippet`）的规则文件。
#
# - `snippet_def` 用于验证定义引用片段：脚本表达式为 `test` 时，要求存在类型为 `test_type` 的定义
#   `test_a`（对应模板 `$_a`）或 `b_foo`（对应模板 `b_$`）。
# - `snippet_loc` 用于验证本地化引用片段：脚本表达式为 `test` 时，要求存在本地化
#   `test_desc`（对应模板 `$_desc`）或 `test_effect`（对应模板 `$_effect`）。

types = {
    type[test_type] = {
        path = "common/test_types"
        path_extension = .txt
    }
}

test_type = {
    snippet_def = <test_type>|$_a,b_$
    snippet_loc = localisation|$_desc,$_effect
}
